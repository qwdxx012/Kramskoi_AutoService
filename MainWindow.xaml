<Window x:Class="Kramskoi_AutoService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Kramskoi_AutoService"
        mc:Ignorable="d"
        Title="Автосервис Иванов" Height="500" Width="800"
        MinHeight="500" MinWidth="800"
        Icon="Resources/icon.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF76E383">
            <Image Width="45" Height="45" HorizontalAlignment="Left" Margin="5"
                   Source="Resources/logo.png"/>
            <Button x:Name="btnBack" HorizontalAlignment="Right" Content="Назад"
                    Click="btnBack_Click"/>
        </Grid>

        <Frame x:Name="FrmMain" Grid.Row="1"
               NavigationUIVisibility="Hidden"
               ContentRendered="FrmMain_ContentRendered"/>
    </Grid>
</Window>
